{
  "name": "pump-and-dump-screener",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "fetch:all": "pnpm --filter fetch-market-archives run all",
    "fetch:tail": "pnpm --filter fetch-market-archives run tail",
    "migrate:ndjson": "pnpm --filter fetch-market-archives run migrate:ndjson",
    "fetch:archives": "pnpm --filter fetch-market-archives start",
    "fetch:archives:exchange": "pnpm --filter fetch-market-archives run exchange",
    "report:coverage": "pnpm --filter fetch-market-archives run report:coverage",
    "scan:pumps": "pnpm --filter run-pump-detector start",
    "pump:monitor": "pnpm --filter pump-monitor start",
    "pump:bot": "pnpm --filter pump-monitor run bot",
    "pump:web": "pnpm --filter pump-monitor run web",
    "telegram:backfill-subscribers": "pnpm --filter pump-monitor run backfill:telegram-subscribers",
    "db:bootstrap": "pnpm --filter @screener/db run bootstrap",
    "pump:import-index": "pnpm --filter @screener/db run import-pump-index"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
