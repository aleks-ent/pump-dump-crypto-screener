{
  "name": "@screener/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/bootstrap-cli.ts src/import-cli.ts --format esm --dts --clean",
    "bootstrap": "tsx src/bootstrap-cli.ts",
    "import-pump-index": "tsx src/import-cli.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@screener/core": "workspace:*",
    "@screener/pump-detector": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
